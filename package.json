{
  "name": "seen-and-gone",
  "version": "2.0.0",
  "private": true,
  "description": "A room-code chat where every message burns away right after it is seen. No storage, no history.",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "db:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chat",
    "ephemeral",
    "vanishing-messages",
    "self-destruct",
    "privacy",
    "cloudflare-workers"
  ],
  "license": "MIT"
}
